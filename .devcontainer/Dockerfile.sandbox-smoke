FROM rust:1.95.0-bookworm

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    bubblewrap \
    ca-certificates \
    clang \
    cmake \
    git \
    libasound2-dev \
    libcap-dev \
    libclang-dev \
    libssl-dev \
    pkg-config \
    python3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 codex \
    && mkdir -p /codex-target /home/codex/.cargo/registry /home/codex/.cargo/git /home/codex/.codex \
    && touch /home/codex/.codex/.volume-init \
    && chown -R codex:codex /codex-target /home/codex/.cargo /home/codex/.codex

ENV CARGO_HOME=/home/codex/.cargo
ENV CARGO_TARGET_DIR=/codex-target

USER codex
WORKDIR /workspace/codex-rs
